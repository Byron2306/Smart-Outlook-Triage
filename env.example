# Gemini API key for AI features (classification, drafting, summarization)
# Get one free at https://aistudio.google.com/apikey
GEMINI_API_KEY=replace_with_your_gemini_api_key

# Optional: Port to run on (default 3000)
PORT=3000
HOST=127.0.0.1

# DIO commercial authority. Outbound sending is off unless explicitly enabled.
DIO_OUTBOUND_MAIL_ENABLED=false
DIO_MAIL_INTENT_DIR=/home/byron/Downloads/KnowEdge_AutoRelease_Suite/state/mail_intents
DIO_CONTROL_POLICY_PATH=/home/byron/Downloads/KnowEdge_AutoRelease_Suite/state/control_policy.json

# Keep password submission to the browser-agent API disabled. Use interactive sign-in.
ALLOW_PASSWORD_LOGIN=false
